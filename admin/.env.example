# -----------------------------------------------------------------------------
# Admin Portal environment variables
#
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time, so
# every visitor can read them. Only public values belong here:
#   - The Supabase URL and anon / publishable key ARE public by design. Access
#     is enforced by the backend (it checks the token on every request) and by
#     Row Level Security in Supabase.
#   - The Supabase service-role / secret key is NOT. Never add it here (or
#     anywhere in this app); it stays on the backend.
# -----------------------------------------------------------------------------

# Base URL of the ASP.NET Core Web API, INCLUDING `/api` (no trailing slash needed).
#   Production: https://slvp-api.kape-dev.workers.dev/api
#   Local backend (SLVP-BE, "http" launch profile): http://localhost:5239/api
NEXT_PUBLIC_API_URL=

# Supabase project (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key, never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local only: "true" opens the dashboard without signing in (as "Local Dev").
# Ignored outside `npm run dev`, so it can never switch on in a deployed build.
# The API must allow tokenless admin calls (backend Auth:Enforce=false, the default).
NEXT_PUBLIC_DEV_SKIP_AUTH=

# Local only: the photo editor (/photo-editor-test) removes backgrounds with the
# real Cloudflare Images service (the `dev` environment in wrangler.jsonc), which
# needs `npx wrangler login` once. Set to "false" to run `npm run dev` without a
# Cloudflare login (background removal then returns the photo unchanged).
CLOUDFLARE_REMOTE_BINDINGS=

# Photo editor uniforms: FLUX.2 models (klein 4B, klein 9B, dev) on Cloudflare
# Workers AI, over its REST API. In production these are Worker secrets
# (`npx wrangler secret put WORKERS_AI_API_TOKEN`); locally they can go here or
# in .dev.vars. The token needs Workers AI Read and Edit (dashboard template
# "Workers AI"). Never commit real values.
WORKERS_AI_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
