# -----------------------------------------------------------------------------
# Admin Portal environment variables
#
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time, so
# every visitor can read them. Only public values belong here:
#   - The Supabase URL and anon / publishable key ARE public by design. Access
#     is enforced by the backend (it checks the token on every request) and by
#     Row Level Security in Supabase.
#   - The Supabase service-role / secret key is NOT. Never add it here (or
#     anywhere in this app); it stays on the backend.
# -----------------------------------------------------------------------------

# Base URL of the ASP.NET Core Web API, INCLUDING `/api` (no trailing slash needed).
#   Production: https://slvp-api.kape-dev.workers.dev/api
#   Local backend (SLVP-BE, "http" launch profile): http://localhost:5239/api
NEXT_PUBLIC_API_URL=

# Supabase project (Supabase dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
# The anon / publishable key, never the service-role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
