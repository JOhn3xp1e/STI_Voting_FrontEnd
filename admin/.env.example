# -----------------------------------------------------------------------------
# Admin Portal environment variables
#
# Copy this file to `.env.local` and fill in the values:
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* values are embedded in the browser bundle at build time.
# Never put secrets (API keys, connection strings, Supabase keys) in them.
# The database is accessed only through the ASP.NET Core Web API.
# -----------------------------------------------------------------------------

# Base URL of the ASP.NET Core Web API (no trailing slash required).
# Local backend (SLVP-BE, "http" launch profile): http://localhost:5239/api
NEXT_PUBLIC_API_URL=

# Sign-in ANIMATION PREVIEW.
#
# true  -> "Sign in" waits ~2 s, then plays the success animation and opens the
#          dashboard WITHOUT contacting the API. This is a visual demonstration,
#          not authentication: no credentials are checked and no token or
#          session is created.
# false -> (or unset) the real sign-in request is sent to the Web API.
#
# On its own it only works under `npm run dev`; production builds ignore it.
# Remove it or set it to false once the backend sign-in endpoint is ready.
NEXT_PUBLIC_AUTH_DEMO_MODE=false

# Allow the preview above on a DEPLOYED build too (e.g. a Vercel demo).
# Needs NEXT_PUBLIC_AUTH_DEMO_MODE=true as well. Only for demo deployments;
# never set it on the real production site. Redeploy after changing it.
NEXT_PUBLIC_ALLOW_DEMO_ON_DEPLOY=false
