{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "slvp-admin",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "slvp-admin"
		},
		{
			// AI for "Convert with AI" (../ai, the slvp-ai worker). Deploy slvp-ai before this worker.
			// Calls carry the AI_API_TOKEN secret (same value as on slvp-ai).
			"binding": "SLVP_AI",
			"service": "slvp-ai"
		}
	],
	"images": {
		// Optimizes next/image images (see https://opennext.js.org/cloudflare/howtos/image)
		// and removes photo backgrounds in the photo editor (`segment: "foreground"`).
		"binding": "IMAGES"
	},
	// Keep this top level free of remote bindings (`"remote": true`, `"ai"`): the deploy
	// step starts a local proxy from it, and the CI token can't open a remote session.
	// The photo editor's uniforms call Workers AI over its REST API instead (secrets
	// WORKERS_AI_ACCOUNT_ID and WORKERS_AI_API_TOKEN).

	// To persist the Next.js cache, create an R2 bucket and add an "r2_buckets"
	// entry here plus the R2 incremental cache in open-next.config.ts.
	// See https://opennext.js.org/cloudflare/caching

	"env": {
		// Used only by `next dev` (see next.config.ts), never deployed: background
		// removal needs the real Images service, the local stand-in returns the photo unchanged.
		"dev": {
			// SLVP_AI reaches `npm run dev` in ../ai through wrangler's local dev registry.
			"services": [
				{ "binding": "WORKER_SELF_REFERENCE", "service": "slvp-admin" },
				{ "binding": "SLVP_AI", "service": "slvp-ai" }
			],
			"images": {
				"binding": "IMAGES",
				"remote": true
			}
		}
	}
}
